# ============================================================
# HealthTrack Pro — Environment Variables Template
# Copy this file to .env and fill in your values.
# ============================================================

# --- MySQL Database ---
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_DATABASE=healthtrack_db
MYSQL_USER=healthtrack_user
MYSQL_PASSWORD=healthtrack_pass123

# --- Backend / Spring Boot ---
DB_URL=jdbc:mysql://mysql:3306/healthtrack_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=healthtrack_user
DB_PASSWORD=healthtrack_pass123

# JWT Configuration (use a strong 256-bit secret in production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server
SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
